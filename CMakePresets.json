{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "wsl-gcc17-cxx29-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "/opt/gcc-trunk/bin/g++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_BUILD_RPATH": "/opt/gcc-trunk/lib64"
      },
      "environment": {
        "PATH": "/opt/gcc-trunk/bin:$penv{PATH}",
        "LD_LIBRARY_PATH": "/opt/gcc-trunk/lib64:$penv{LD_LIBRARY_PATH}"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [
            "Linux"
          ],
          "intelliSenseMode": "linux-gcc-x64",
          "intelliSenseOptions": {
            "useCompilerDefaults": true,
            "additionalCompilerArgs": [
              "-std=c++29",
              "-freflection"
            ]
          }
        },
        "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
          "sourceDir": "$env{HOME}/.vs/$ms{projectDirName}",
          "copySources": true,
          "copySourcesOptions": {
            "exclusionList": [
              ".git",
              ".vs",
              "build",
              "out"
            ]
          },
          "copyAdditionalIncludeDirectoriesList": [
            "/opt/gcc-trunk/include/c++/17.0.0",
            "/opt/gcc-trunk/include/c++/17.0.0/x86_64-pc-linux-gnu",
            "/opt/gcc-trunk/include/c++/17.0.0/backward",
            "/opt/gcc-trunk/lib/gcc/x86_64-pc-linux-gnu/17.0.0/include",
            "/usr/local/include",
            "/opt/gcc-trunk/include",
            "/opt/gcc-trunk/lib/gcc/x86_64-pc-linux-gnu/17.0.0/include-fixed",
            "/usr/include/x86_64-linux-gnu",
            "/usr/include"
          ],
          "copyBuildOutput": false
        }
      }
    },
    {
      "name": "wsl-gcc17-cxx29-debug",
      "displayName": "WSL GCC 17 trunk - C++29 - Debug",
      "description": "Debug build in Ubuntu-26.04 with GCC 17 trunk and C++29",
      "inherits": "wsl-gcc17-cxx29-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "wsl-gcc17-cxx29-release",
      "displayName": "WSL GCC 17 trunk - C++29 - Release",
      "description": "Release build in Ubuntu-26.04 with GCC 17 trunk and C++29",
      "inherits": "wsl-gcc17-cxx29-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "wsl-gcc17-cxx29-debug",
      "displayName": "Build WSL GCC 17 trunk - C++29 - Debug",
      "configurePreset": "wsl-gcc17-cxx29-debug",
      "verbose": true
    },
    {
      "name": "wsl-gcc17-cxx29-release",
      "displayName": "Build WSL GCC 17 trunk - C++29 - Release",
      "configurePreset": "wsl-gcc17-cxx29-release",
      "verbose": true
    }
  ]
}
